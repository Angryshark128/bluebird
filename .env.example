# 复制为 .env 后填写（.env 不入库）
# 要接收通知的 GitHub 账号（留空 = 处理所有仓库事件；通常填你自己的账号，避免收到无关事件）
NOTIFY_OWNER=
# Webhook secret：openssl rand -hex 32 生成，创建 GitHub App 时填同一值
WEBHOOK_SECRET=
# Bark（iOS 推送；BARK_URL 默认官方服务 https://api.day.app）
BARK_URL=https://api.day.app
# Bark 推送 key
BARK_KEY=
# Bark 通知 subtitle 来源标识
BARK_SOURCE=github
# 可选扩展渠道（留空 = 不启用）
# 飞书自定义机器人 webhook（https://open.feishu.cn 群组 → 设置 → 群机器人 → 自定义机器人）
FEISHU_WEBHOOK=
# 飞书加签密钥（开启"签名校验"时必填，未开启留空）
FEISHU_SECRET=
# 企业微信群机器人 webhook（群设置 → 群机器人 → 添加机器人）
WECOM_WEBHOOK=
# PushDeer（api2.pushdeer.com 或自建服务；PUSHDEER_URL 默认官方地址）
PUSHDEER_URL=https://api2.pushdeer.com
# PushDeer 推送 key（多个 key 用英文逗号分隔）
PUSHDEER_KEY=
# 通用 Webhook 渠道：任意能接收 HTTP POST 的地址（留空 = 不启用）
# 请求体为 JSON {"title","body","source"}；填了签名密钥则附带头
#   X-Bluebird-Signature-256: sha256=<HMAC-SHA256(请求体)>
GENERIC_WEBHOOK_URL=
GENERIC_WEBHOOK_SECRET=
# 通用 Hook 源 token（启用 /hooks/<源名>；留空 = 不启用）。
# 任意脚本/设备 POST JSON {"title","body","event","repo"} 或纯文本，携带请求头
#   Authorization: Bearer <Token>
# 即可推送
GENERIC_TOKEN=
# 审计面板
# 审计日志保留天数
LOG_RETENTION_DAYS=30
# 面板登录凭据（必填）：任一项为空则面板 / API / 文档一律拒绝访问（fail-closed）
NOTIFY_AUTH_USER=
NOTIFY_AUTH_PASS=
# 面板会话签名密钥（可选：留空则首启随机生成并持久化到数据库，一般无需设置）
UI_SESSION_SECRET=
# 单请求体上限（字节，默认 1048576）与单连接读写超时（秒，默认 30）；不填即用默认值
# MAX_BODY_BYTES=1048576
# NOTIFY_TIMEOUT=30
# 子路径部署前缀（如 https://example.com/bluebird/ → 填 bluebird）。
# 默认留空 = 根路径部署（子域名，推荐）；设置 BASE_PATH=bluebird 可挂子路径
BASE_PATH=
